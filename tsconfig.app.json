{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "target": "es2023",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "esnext",
    "types": ["vite/client"],
    "allowArbitraryExtensions": true,
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",

    /* Пути. Без baseUrl (deprecated, отключается в TS 7): записи paths заданы
       относительно каталога tsconfig, этого достаточно. */
    "paths": {
      "@/*": ["./src/*"]
    },

    /* Строгость — PLAN 1.2. Схема насыщена nullable-полями и словарями
       «enum → лейбл»; без этих флагов TS пропустит ровно те ошибки,
       которые описаны в OPENAPI_ANALYSIS.md (⑦ ㉛ ㉜). */
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "noImplicitReturns": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["src", "tests"]
}
